---
// Placeholder for a real in-game capture. It must never be replaced with artwork that could be
// mistaken for gameplay; swap in a genuine screenshot when one is available.
interface Props { title: string; description: string; locale?: 'en' | 'zh-tw'; }
const { title, description, locale = 'en' } = Astro.props;
const zh = locale === 'zh-tw';
---

<figure class="screenshot-slot">
	<div class="slot-frame" aria-hidden="true">
		<svg viewBox="0 0 48 48" width="40" height="40"><rect x="5" y="11" width="38" height="28" rx="3" fill="none" stroke="currentColor" stroke-width="2.5"/><circle cx="24" cy="25" r="7" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M17 11l3-5h8l3 5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/></svg>
		<span>{zh ? '待補截圖' : 'Screenshot pending'}</span>
	</div>
	<figcaption>
		<strong>{title}</strong>
		<p>{description}</p>
	</figcaption>
</figure>
