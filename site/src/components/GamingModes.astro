---
// Concept illustration of the three planned AI Gaming modes. Without JavaScript every mode is shown;
// with it, the selected mode is shown on its own.
interface Props { locale?: 'en' | 'zh-tw'; }
const { locale = 'en' } = Astro.props;
const zh = locale === 'zh-tw';
const modes = zh
	? [
		{ id: 'watch', label: '看 AI 玩', ai: 'AI 觀察城市、做決定並親自建設。', you: '你在旁觀看，隨時可以暫停或接手。', flow: 'AI → 遊戲' },
		{ id: 'assist', label: 'AI 協助', ai: 'AI 分析城市，提出建議與理由。', you: '你檢查建議，自己決定要不要照做。', flow: 'AI → 你 → 遊戲' },
		{ id: 'play', label: 'AI 接手', ai: 'AI 在你允許的範圍內執行操作。', you: '你設定它能做哪些事，並保留最終控制權。', flow: 'AI → 遊戲（限定範圍）' },
	]
	: [
		{ id: 'watch', label: 'Watch AI play', ai: 'The AI reads the city, decides and builds on its own.', you: 'You watch, and can pause or take over at any time.', flow: 'AI → game' },
		{ id: 'assist', label: 'AI assists you', ai: 'The AI studies the city and suggests what to do, with reasons.', you: 'You review each suggestion and decide whether to follow it.', flow: 'AI → you → game' },
		{ id: 'play', label: 'AI takes over', ai: 'The AI acts within the limits you allow.', you: 'You choose what it may do and keep the final say.', flow: 'AI → game (within limits)' },
	];
---

<section class="gaming-modes" aria-labelledby="mode-title">
	<p class="concept-label">{zh ? '構想示意 · 尚未實作' : 'Concept · not available yet'}</p>
	<fieldset>
		<legend id="mode-title">{zh ? '選擇一種玩法' : 'Choose a way to play'}</legend>
		<div class="mode-options">
			{modes.map((mode, index) => <label class="mode-option"><input type="radio" name="gaming-mode" value={mode.id} checked={index === 0} /><span>{mode.label}</span></label>)}
		</div>
	</fieldset>
	<div class="mode-diagram" aria-label={zh ? '遊戲、AI Gaming 與 AI 之間的資料流程' : 'Data flow between the game, AI Gaming and the AI'}>
		<div class="mode-node"><strong>Cities: Skylines 1</strong><small>{zh ? '你的城市' : 'your city'}</small></div>
		<span aria-hidden="true">⇄</span>
		<div class="mode-node accent"><strong>AI Gaming</strong><small>{zh ? '規劃中的玩法構想' : 'planned mode concepts'}</small></div>
		<span aria-hidden="true">⇄</span>
		<div class="mode-node"><strong>AI</strong><small>{zh ? '未來 AI 玩法' : 'future AI modes'}</small></div>
	</div>
	<div class="mode-cards">
		{modes.map((mode) => <article class="mode-card" data-mode-detail={mode.id}>
			<h3>{mode.label}<span>{mode.flow}</span></h3>
			<dl><div><dt>{zh ? 'AI 負責' : 'The AI'}</dt><dd>{mode.ai}</dd></div><div><dt>{zh ? '你負責' : 'You'}</dt><dd>{mode.you}</dd></div></dl>
		</article>)}
	</div>
</section>

<script>
	const field = document.querySelector<HTMLElement>('.gaming-modes');
	if (field) {
		const radios = [...field.querySelectorAll<HTMLInputElement>('input[name="gaming-mode"]')];
		const cards = [...field.querySelectorAll<HTMLElement>('[data-mode-detail]')];
		const show = (radio: HTMLInputElement) => cards.forEach((card) => { card.hidden = card.dataset.modeDetail !== radio.value; });
		const active = radios.find((radio) => radio.checked);
		if (active) show(active);
		radios.forEach((radio) => radio.addEventListener('change', () => show(radio)));
	}
</script>

<style>
	.gaming-modes { margin-top: 24px; padding: clamp(18px, 3vw, 32px); background: var(--ground); }
	.concept-label { color: var(--route) !important; font-size: 12px !important; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
	.gaming-modes fieldset { margin: 16px 0 0; padding: 0; border: 0; }
	.gaming-modes legend { margin-bottom: 10px; font-weight: 700; }
	.mode-options { display: flex; flex-wrap: wrap; gap: 8px; }
	.mode-option { position: relative; cursor: pointer; }
	.mode-option input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
	.mode-option span { display: block; padding: 11px 16px; background: var(--surface); font-weight: 600; }
	.mode-option input:checked + span { background: var(--ink); color: var(--ground); }
	.mode-option input:focus-visible + span { outline: 3px solid var(--focus); outline-offset: 3px; }
	.mode-diagram { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; align-items: center; gap: 14px; margin: 28px 0; }
	.mode-node { padding: 22px 16px; background: var(--surface); text-align: center; }
	.mode-node.accent { outline: 2px solid var(--route); }
	.mode-node strong, .mode-node small { display: block; }
	.mode-node strong { font: 700 20px/1.2 var(--display); }
	.mode-node small { margin-top: 6px; color: var(--muted); font-size: 13px; }
	.mode-diagram > span { color: var(--route); font-size: 28px; }
	.mode-cards { display: grid; gap: 12px; }
	.mode-card { padding: 20px; border-left: 3px solid var(--route); background: var(--surface); }
	.mode-card h3 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px; font-size: 22px; letter-spacing: -.02em; }
	.mode-card h3 span { color: var(--muted); font: 600 13px/1.2 var(--text); letter-spacing: 0; }
	.mode-card dl { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 14px 0 0; }
	.mode-card dt { color: var(--route); font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
	.mode-card dd { margin: 4px 0 0; color: var(--muted); }
	@media (max-width: 640px) {
		.mode-diagram { grid-template-columns: 1fr; gap: 6px; }
		.mode-diagram > span { justify-self: center; transform: rotate(90deg); }
		.mode-card dl { grid-template-columns: 1fr; }
	}
</style>
