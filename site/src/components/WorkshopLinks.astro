---
import { workshop, workshopUrl } from '../data/workshop';
interface Props { mod: 'ai-improve' | 'transport' | 'ai-gaming'; locale?: 'en' | 'zh-tw'; }
const { mod, locale = 'en' } = Astro.props;
const zh = locale === 'zh-tw';
const items = workshop[mod];
// GitHub prereleases are separate from the Workshop editions. OpenAI-Codex_Responsible: Modpack_Website.
const developmentReleases = {
	'ai-gaming': { name: 'AI Gaming', tag: 'ai-gaming-dev-41185662728-1', status: 'The GitHub Development build includes a matching Windows x64 Companion; in-game behavior remains unverified.' },
	'ai-improve': { name: 'AI Improve', tag: 'ai-improve-dev-41185802009-1', status: 'The GitHub Development build requires its matching CitiesHarmony.API.dll and the Harmony Workshop mod.' },
	transport: { name: 'Automated Public Transport Planning', tag: 'aptp-dev-41185686621-1', status: 'The GitHub Development prototype can attempt to create a selected route after confirmation and may change a save; it is not read-only.' },
} as const;
const developmentRelease = developmentReleases[mod];
const labels = {
	release: 'Steam Workshop Stable',
	development: 'Steam Workshop Development',
};
---

<div class="workshop-links">
	<a class="button github-development" href={'https://github.com/KingsleyHK0323/Cities_Skylines_1_Modpack/releases/tag/' + developmentRelease.tag}>Download {developmentRelease.name} Development build <span aria-hidden="true">↗</span></a>
	{(['release', 'development'] as const).map((edition) => items[edition].public
		? <a class={edition === 'release' ? 'button' : 'button secondary'} href={workshopUrl(items[edition].id)}>{labels[edition]} <span aria-hidden="true">↗</span></a>
		: <span class="button pending" aria-disabled="true">{labels[edition]} · {zh ? '尚未公開' : 'not yet public'}</span>)}
</div>
<p class="workshop-note" lang="en">Workshop and GitHub Development editions are separate and may differ. Enable only one copy of each mod.</p>
<div class="development-notice" lang="en">
	<p><strong>GitHub Development prerelease:</strong> {developmentRelease.status}</p>
	<p>Back up saves and test on a separate city. Do not enable this build alongside another copy. <a href={'https://github.com/KingsleyHK0323/Cities_Skylines_1_Modpack/releases/tag/' + developmentRelease.tag}>Download {developmentRelease.name} Development build</a> · <a href={import.meta.env.BASE_URL + 'wiki/development-downloads/'}>Installation and risks</a></p>
</div>
<style>
	/* Prioritize the current GitHub build while preserving Workshop access.
	   OpenAI-Codex_Responsible: Modpack_Website. */
	.github-development { max-width: 100%; text-align: center; overflow-wrap: anywhere; }
	.workshop-links a[href*="steamcommunity.com"] { background: transparent; color: var(--ink); border-color: var(--field); }
	.development-notice { margin-top: 1rem; padding: 1rem; border: 1px solid currentColor; border-radius: 0.5rem; }
	.development-notice p { margin: 0 0 0.6rem; }
	.development-notice p:last-child { margin-bottom: 0; }
</style>
<!-- Updated by OpenAI-Codex on 2026-10-26. -->
