---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import { changeEntries } from '../lib/changelog';
import { harmonyUrl } from '../data/workshop';
import cityArt from '../assets/brand/modpack-city.png';
import aiImproveArt from '../assets/projects/ai-improve.png';
import transportArt from '../assets/projects/transport.png';
import aiGamingArt from '../assets/projects/ai-gaming.png';
const base = import.meta.env.BASE_URL;
const recent = changeEntries.slice(0, 5);
const projects = [
	{ art: aiImproveArt, name: 'AI Improve', status: 'Available on the Workshop', text: 'Vehicles, services and citizens that react to what is actually happening in your city: jams, crowded platforms, nearby fires and full depots.', page: 'ai-improve/', wiki: 'wiki/ai-improve/overview/' },
	{ art: transportArt, name: 'Automated Public Transport Planning', status: 'Early preview 0.2.0', text: 'Will plan bus lines from your city’s real demand and show every line as a preview before anything is built. Today it surveys the network.', page: 'automated-public-transport-planning/', wiki: 'wiki/transport/overview/' },
	{ art: aiGamingArt, name: 'AI Gaming', status: 'Early preview 0.1.0', text: 'Connects a local or cloud AI to the game, so you can watch it build, let it advise you, or hand it the controls. Today it reads a city summary.', page: 'ai-gaming/', wiki: 'wiki/ai-gaming/overview/' },
];
---

<SiteLayout title="Cities: Skylines 1 Modpack" description="Three Cities: Skylines 1 mods by Kingsley that work together: smarter city AI, automatic bus planning and AI that plays the game." active="home">
	<section class="hero page-wrap">
		<div class="hero-copy">
			<p class="eyebrow">Cities: Skylines 1 mods by Kingsley</p>
			<h1>Make the city work better.</h1>
			<p class="hero-lead">Three mods built to work together: smarter decisions for the vehicles and citizens in your city, automatic public transport planning, and an AI that can play the game with you.</p>
			<div class="hero-actions"><a class="button" href={base + 'wiki/getting-started/'}>Get started</a><a class="button secondary" href={base + 'ai-improve/'}>Explore AI Improve</a></div>
		</div>
		<figure class="hero-art"><Image src={cityArt} alt="Illustrated city block crossed by a red transit line" widths={[520, 760]} sizes="(max-width: 640px) 100vw, 45vw" format="webp" quality={78} loading="eager" /><figcaption class="art-note">Illustration · not a gameplay screenshot</figcaption></figure>
	</section>

	<section class="section soft">
		<div class="page-wrap">
			<div class="section-heading"><div><p class="eyebrow">The mods</p><h2>Three mods, one city.</h2></div><p>Each mod works on its own, and they are designed not to conflict when you use them together.</p></div>
			<div class="project-grid">
				{projects.map((p) => <article class="project-card"><Image src={p.art} alt={p.name + ' artwork'} widths={[420, 640]} sizes="(max-width: 640px) 100vw, 33vw" format="webp" quality={76} /><div class="project-card-copy"><h3>{p.name}</h3><span class="status">{p.status}</span><p>{p.text}</p><div class="card-links"><a href={base + p.page}>Project page →</a><a href={base + p.wiki}>Guide →</a></div></div></article>)}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="page-wrap columns">
			<div class="text-stack"><p class="eyebrow">How to begin</p><h2>Three steps to your first city.</h2><p>Every mod page links to its Workshop items, and the Wiki explains each setting in detail.</p><div class="hero-actions"><a class="button" href={base + 'wiki/getting-started/'}>Read the full guide</a></div></div>
			<ol class="steps">
				<li><strong>Subscribe to Harmony</strong><p>AI Improve needs the <a href={harmonyUrl}>Harmony</a> mod, a shared library many Cities: Skylines mods depend on.</p></li>
				<li><strong>Pick Release or Development</strong><p>Release is for everyday play. Development gets changes first and includes testing tools. Subscribe to one, never both.</p></li>
				<li><strong>Enable it and adjust</strong><p>Turn the mod on in the Content Manager, then open its options to switch individual features on or off.</p></li>
			</ol>
		</div>
	</section>

	<section class="section soft">
		<div class="page-wrap">
			<div class="section-heading"><div><p class="eyebrow">Latest updates</p><h2>What changed recently.</h2></div><a href={base + 'change-log/'}>Full change log →</a></div>
			<ul class="update-list">{recent.map((entry) => <li><time>{entry.date}</time><span>{entry.title}</span></li>)}</ul>
		</div>
	</section>
</SiteLayout>
