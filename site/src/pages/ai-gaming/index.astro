---
import { Image } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ScreenshotSlot from '../../components/ScreenshotSlot.astro';
import GamingModes from '../../components/GamingModes.astro';
import WorkshopLinks from '../../components/WorkshopLinks.astro';
import art from '../../assets/projects/ai-gaming.png';
const base = import.meta.env.BASE_URL;
---

<SiteLayout title="AI Gaming" description="AI Gaming will connect a local or cloud AI to Cities: Skylines 1 so you can watch it play, take its advice or hand it the controls. Early preview 0.1.0." path="ai-gaming/" active="mods">
	<section class="hero page-wrap">
		<div class="hero-copy">
			<p class="eyebrow">Mod 03 · Early preview 0.1.0</p>
			<h1>AI Gaming</h1>
			<p class="hero-lead">What if an AI could play Cities: Skylines? AI Gaming will connect a local AI model or a cloud AI service to the game, so you can watch an AI build a city, let it advise you, or hand it the controls.</p>
			<div class="status-strip"><span class="tag">No network connections yet</span><span class="tag">No API keys needed</span><span class="tag">English · 繁體中文</span></div>
			<WorkshopLinks mod="ai-gaming" />
		</div>
		<figure class="hero-art"><Image src={art} alt="AI Gaming artwork" widths={[560, 720]} sizes="(max-width: 640px) 100vw, 45vw" format="webp" quality={78} loading="eager" /><figcaption class="art-note">Project artwork · not a gameplay screenshot</figcaption></figure>
	</section>

	<nav class="subnav page-wrap" aria-label="AI Gaming guide"><a href={base + 'wiki/ai-gaming/overview/'}>Guide</a><a href={base + 'wiki/project/roadmap/'}>Roadmap</a></nav>

	<section class="section soft">
		<div class="page-wrap columns">
			<div class="text-stack">
				<p class="eyebrow">In this preview</p>
				<h2>Observe before acting.</h2>
				<p>An AI first has to understand the city. This preview takes that first step: from the mod options you can write a short city summary — population, funds and in-game date — to the game log.</p>
				<p>It does not control the game, makes no network connections and asks for no API keys.</p>
			</div>
			<div class="screenshot-stack">
				<ScreenshotSlot title="Mod options" description="The status, version and the Write city summary to log button." />
				<ScreenshotSlot title="City summary in the log" description="One line with the date, population and funds of the loaded city." />
			</div>
		</div>
	</section>

	<section class="interactive-section"><div class="page-wrap"><p class="section-label">The idea · three ways to play</p><h2>How you and the AI could share a city.</h2><GamingModes locale="en" /></div></section>

	<section class="section">
		<div class="page-wrap">
			<p class="eyebrow">Roadmap and safeguards</p>
			<h2>You stay in control.</h2>
			<div class="roadmap"><article><strong>1 · Observe</strong><p>Read the city in a form an AI can understand.</p></article><article><strong>2 · Suggest</strong><p>AI suggestions that you review before anything happens.</p></article><article><strong>3 · Act, with permission</strong><p>Limited AI actions that you switch on yourself.</p></article></div>
			<p class="section-intro">AI Gaming will work through the other Modpack mods — such as AI Improve and Automated Public Transport Planning — instead of duplicating them, and its design keeps API keys out of your save and the game log.</p>
			<a class="text-link" href={base + 'wiki/project/roadmap/'}>Full roadmap →</a>
		</div>
	</section>
</SiteLayout>
