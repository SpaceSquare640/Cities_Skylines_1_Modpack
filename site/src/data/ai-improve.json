          "tunables": [
            {
              "key": "tune.citizenCarDensity",
              "label": {
                "en": "Congestion threshold",
                "zhTW": "壅塞判定閾值",
                "zhTWFallback": false
              },
              "description": {
                "en": "How congested a destination has to be (0-100) before citizens start becoming less likely to drive there.",
                "zhTW": "目的地的壅塞度要達到多少（0-100）才會開始降低市民開車過去的機率。",
                "zhTWFallback": false
              },
              "setting": "CitizenCarDensityThreshold",
              "property": "CitizenCarDensityThreshold",
              "type": "int",
              "defaultValue": 70,
              "min": 20,
              "max": 100,
              "step": 5
            },
            {
              "key": "tune.citizenCarReduction",
              "label": {
                "en": "Max probability reduction (%)",
                "zhTW": "最大機率降幅 (%)",
                "zhTWFallback": false
              },
              "description": {
                "en": "The largest share of a citizen's drive-probability that congestion is allowed to remove, even at maximum congestion.",
                "zhTW": "即使在最壅塞的情況下，壅塞最多可以降低市民開車機率的百分比上限。",
                "zhTWFallback": false
              },
              "setting": "CitizenCarMaxReductionPercent",
              "property": "CitizenCarMaxReductionPercent",
              "type": "int",
              "defaultValue": 60,
              "min": 0,
              "max": 100,
              "step": 5
            }
          ]
        },
        {
