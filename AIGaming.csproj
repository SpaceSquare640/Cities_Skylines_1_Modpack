<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>AIGaming</AssemblyName>
    <RootNamespace>AIGaming</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.4.0</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
    <InformationalVersion>0.4.0 - Ollama Local companion preview</InformationalVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CSInstallPath Condition="'$(CSInstallPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Cities_Skylines</CSInstallPath>
    <DevTools Condition="'$(DevTools)' == ''">false</DevTools>
    <CompanionEdition Condition="'$(CompanionEdition)' == '' and '$(DevTools)' == 'true'">development</CompanionEdition>
    <CompanionEdition Condition="'$(CompanionEdition)' == ''">release</CompanionEdition>
    <CompanionVersion Condition="'$(CompanionVersion)' == ''">$(Version)</CompanionVersion>
    <CompanionProtocolVersion Condition="'$(CompanionProtocolVersion)' == ''">1</CompanionProtocolVersion>
    <CompanionSha256 Condition="'$(CompanionSha256)' == ''">UNCONFIGURED</CompanionSha256>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ICities">
      <HintPath>$(CSInstallPath)\Cities_Data\Managed\ICities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ColossalManaged">
      <HintPath>$(CSInstallPath)\Cities_Data\Managed\ColossalManaged.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(CSInstallPath)\Cities_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(CSInstallPath)\Cities_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Source\Development\**\*.cs" />
    <Compile Remove="Companion\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <CompanionBuildInfoLine Include="namespace AIGaming {" />
    <CompanionBuildInfoLine Include="    internal static class CompanionBuildInfo {" />
    <CompanionBuildInfoLine Include="        internal const string Edition = &quot;$(CompanionEdition)&quot;%3B" />
    <CompanionBuildInfoLine Include="        internal const string Version = &quot;$(CompanionVersion)&quot;%3B" />
    <CompanionBuildInfoLine Include="        internal const string ProtocolVersion = &quot;$(CompanionProtocolVersion)&quot;%3B" />
    <CompanionBuildInfoLine Include="        internal const string Sha256 = &quot;$(CompanionSha256)&quot;%3B" />
    <CompanionBuildInfoLine Include="    }" />
    <CompanionBuildInfoLine Include="}" />
  </ItemGroup>

  <Target Name="GenerateCompanionBuildInfo" BeforeTargets="CoreCompile">
    <WriteLinesToFile
      File="$(IntermediateOutputPath)CompanionBuildInfo.g.cs"
      Lines="@(CompanionBuildInfoLine)"
      Overwrite="true"
      Encoding="UTF-8" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)CompanionBuildInfo.g.cs" />
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(DevTools)' == 'true'">
    <Compile Include="Source\Development\**\*.cs" />
  </ItemGroup>

  <Target Name="WarnDevTools" BeforeTargets="Build" Condition="'$(DevTools)' == 'true'">
    <Warning Text="DevTools=true: this DLL is development-only. Upload it only to the matching Development Workshop item, never to a Release item." />
  </Target>

</Project>
